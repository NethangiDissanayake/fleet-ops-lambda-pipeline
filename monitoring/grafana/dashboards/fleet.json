  {
   "id": 7,
   "type": "timeseries",
   "title": "Events / second: produced vs processed vs invalid",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "refId": "A",
     "expr": "sum(rate(stream_events_produced_total[30s]))",
     "legendFormat": "produced (Kafka)",
     "format": "time_series"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "refId": "B",
     "expr": "sum(rate(spark_events_received_total[30s]))",
     "legendFormat": "processed (Spark)",
     "format": "time_series"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "refId": "C",
     "expr": "sum(rate(spark_events_invalid_total[30s]))",
     "legendFormat": "invalid",
     "format": "time_series"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Fleet earnings per minute (LKR)",
   "datasource": {
    "type": "postgres",
    "uid": "fleet-pg"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "postgres",
      "uid": "fleet-pg"
     },
     "refId": "A",
     "format": "time_series",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT window_start AS time, sum(earnings) AS earnings FROM zone_metrics_1m WHERE $__timeFilter(window_start) GROUP BY 1 ORDER BY 1"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
