  {
   "id": 14,
   "type": "table",
   "title": "Least profitable vehicles - latest daily report",
   "datasource": {
    "type": "postgres",
    "uid": "fleet-pg"
   },
   "gridPos": {
    "x": 0,
    "y": 28,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "datasource": {
      "type": "postgres",
      "uid": "fleet-pg"
     },
     "refId": "A",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT vehicle_id, status, earnings, total_cost, profit, margin FROM daily_profitability WHERE sim_date = (SELECT max(sim_date) FROM daily_profitability) ORDER BY profit ASC NULLS LAST LIMIT 10"
