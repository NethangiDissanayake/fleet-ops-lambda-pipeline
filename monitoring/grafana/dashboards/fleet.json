  {
   "id": 10,
   "type": "timeseries",
   "title": "Idle ratio per minute",
   "datasource": {
    "type": "postgres",
    "uid": "fleet-pg"
   },
   "gridPos": {
    "x": 8,
    "y": 12,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "postgres",
      "uid": "fleet-pg"
     },
     "refId": "A",
     "format": "time_series",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT window_start AS time, sum(idle_events)::float / nullif(sum(events),0) AS idle_ratio FROM zone_metrics_1m WHERE $__timeFilter(window_start) GROUP BY 1 ORDER BY 1"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
