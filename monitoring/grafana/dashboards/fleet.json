     "mode": "multi"
    }
   }
  },
  {
   "id": 9,
   "type": "bargauge",
   "title": "Earnings by zone - last 5 min (LKR)",
   "datasource": {
    "type": "postgres",
    "uid": "fleet-pg"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "postgres",
      "uid": "fleet-pg"
     },
     "refId": "A",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT zone, sum(earnings) AS earnings FROM zone_metrics_1m WHERE window_start >= now() - interval '5 minutes' GROUP BY zone ORDER BY zone"
