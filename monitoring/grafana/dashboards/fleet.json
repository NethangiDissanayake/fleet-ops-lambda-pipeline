   "targets": [
    {
     "datasource": {
      "type": "postgres",
      "uid": "fleet-pg"
     },
     "refId": "A",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT count(*) AS active FROM vehicle_state WHERE last_ts > now() - interval '30 seconds' AND status <> 'idle'"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": null,
     "thresholds": {
