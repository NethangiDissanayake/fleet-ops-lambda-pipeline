 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Vehicles online",
   "datasource": {
    "type": "postgres",
    "uid": "fleet-pg"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "postgres",
      "uid": "fleet-pg"
     },
     "refId": "A",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT count(*) AS online FROM vehicle_state WHERE last_ts > now() - interval '30 seconds'"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": null,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none"
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Active vehicles",
   "datasource": {
    "type": "postgres",
    "uid": "fleet-pg"
