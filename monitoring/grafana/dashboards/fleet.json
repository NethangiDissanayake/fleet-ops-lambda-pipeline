  {
   "id": 15,
   "type": "bargauge",
   "title": "Earnings by simulated hour - latest day (LKR)",
   "datasource": {
    "type": "postgres",
    "uid": "fleet-pg"
   },
   "gridPos": {
    "x": 12,
    "y": 28,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "datasource": {
      "type": "postgres",
      "uid": "fleet-pg"
     },
     "refId": "A",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT lpad(sim_hour::text, 2, '0') || ':00' AS hour, sum(earnings) AS earnings FROM zone_hourly WHERE sim_date = (SELECT max(sim_date) FROM zone_hourly) GROUP BY sim_hour ORDER BY sim_hour"
    }
   ],
